<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Optional Microsoft.Extensions.VectorData adapter for GraphBridge: search an existing Neo4j node or relationship vector index through IVectorSearchable&lt;TRecord&gt;. The core provider does not depend on it.</Description>
    <Version>0.1.0-preview.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GraphBridge.EntityFrameworkCore/GraphBridge.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../eng/GraphBridge.Package.props" />
  <PropertyGroup>
    <PackageTags>$(PackageTags);VectorData;vector-search;Microsoft.Extensions.AI</PackageTags>
  </PropertyGroup>
</Project>
