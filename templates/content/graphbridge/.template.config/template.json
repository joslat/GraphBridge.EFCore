{
  "$schema": "http://json.schemastore.org/template",
  "author": "GraphBridge contributors",
  "classifications": ["Console", "EF Core", "Neo4j"],
  "identity": "GraphBridge.Starter.CSharp",
  "name": "GraphBridge preview starter",
  "shortName": "graphbridge",
  "sourceName": "GraphBridgeStarter",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "solution" },
  "symbols": {
    "provider-version": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "Exact GraphBridge.EntityFrameworkCore version, for example 0.2.0-preview.1.",
      "replaces": "0.0.0-provider-version-required"
    }
  }
}
