      "text": "/// <summary>WHERE stays attached to OPTIONAL MATCH, preserving people without a qualifying movie.</summary>\npublic static CypherResultQuery<OptionalMovieRow> OptionalMovies(DbContext db, string runId, int afterYear)\n{\n    var actor = Graph.Node<Person>(); var movie = Graph.Node<Movie>();\n    return db.Cypher().Match(actor).Where(actor.Property(p => p.RunId).Eq(runId))\n        .OptionalMatch(actor.Out(Graph.Edge<Credit>(), movie)).Where(movie.Property(p => p.Year).Gt(afterYear))\n        .Return(() => new OptionalMovieRow(actor.Value.Name, movie.Value.Title, (int?)movie.Value.Year))\n        .OrderBy(actor.Property(p => p.Name)).Limit(100);\n}"
