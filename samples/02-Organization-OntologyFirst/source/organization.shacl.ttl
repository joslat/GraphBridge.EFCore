@prefix ex: <https://example.org/org#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PersonShape a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [ sh:path ex:personName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ex:worksFor ; sh:minCount 1 ; sh:class ex:Organization ; sh:nodeKind sh:IRI ] .
ex:OrganizationShape a sh:NodeShape ;
    sh:targetClass ex:Organization ;
    sh:property [ sh:path ex:organizationName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
